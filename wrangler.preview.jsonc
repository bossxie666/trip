{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trip-archive-preview",
  "account_id": "b7d0f996ea7d9df42cdb4df32e91b8e3",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": { "directory": "./dist/client", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "trip-archive-media" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "trip-archive-preview",
    "database_id": "779ad2a2-8425-407f-ba44-2281b1af2e22",
    "migrations_dir": "./migrations"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
